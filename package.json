{
  "name": "birds-llm-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5301",
    "preview": "vite preview --host 127.0.0.1 --port 5301",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "build": "vite build",
    "verify:m0": "tsx scripts/verify-m0.ts",
    "verify:m1": "tsx scripts/verify-m1.ts",
    "verify:m2-learning": "tsx scripts/verify-m2-learning.ts",
    "benchmark:tokenizer": "tsx scripts/benchmark-tokenizer.ts",
    "benchmark:model": "tsx scripts/benchmark-model.ts",
    "export": "tsx scripts/export-corpus.ts",
    "train:tokenizer": "tsx scripts/train-tokenizer.ts",
    "train": "tsx scripts/train.ts",
    "inspect:checkpoint": "tsx scripts/inspect-checkpoint.ts",
    "serve": "tsx server/index.ts",
    "service:install": "tsx scripts/install-launch-agent.ts install",
    "service:status": "tsx scripts/install-launch-agent.ts status",
    "service:restart": "tsx scripts/install-launch-agent.ts restart",
    "service:uninstall": "tsx scripts/install-launch-agent.ts uninstall"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.3",
    "@types/pg": "^8.23.1",
    "node": "22.20.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
